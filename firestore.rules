rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.email == 'ah3992222@gmail.com' ||
         request.auth.token.email == 'milanoyemen@gmail.com' ||
         request.auth.token.email == 'milanostore@gmail.com' ||
         request.auth.token.email == 'payg91254@gmail.com' ||
         request.auth.token.email == 'grgr@getemails.uk');
    }

    // Public store catalogue and storefront settings; write access stays admin-only.
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/pos/workers/{workerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /daily_stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Customer orders can be created by the store, but remain private to administrators.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete, list: if isAdmin();
    }

    // Wallet IDs are random device-bound IDs. Visitors can retrieve only a known wallet document,
    // never list wallet records. They cannot add balance, edit another document's identity, or
    // alter store data. Balance credits and wallet history remain administrator-only.
    match /customer_wallets/{walletId} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if request.resource.data.walletId == walletId &&
        request.resource.data.balance is number &&
        (request.resource.data.balance == 0 || validInitialStoreReward()) &&
        request.resource.data.pinConfigured == true &&
        request.resource.data.deviceBound == true &&
        request.resource.data.phone is string &&
        request.resource.data.pinHash is string &&
        request.resource.data.keys().hasOnly(['walletId', 'phone', 'balance', 'pinHash', 'pinConfigured', 'deviceBound', 'createdAt', 'updatedAt']);
      allow update: if isAdmin() || validWalletPinUpdate() || validWalletDebit();
      allow delete: if isAdmin();

      // A customer receives the configured store reward only on the first creation
      // of their phone-linked wallet. Existing balances stay unchanged and protected.
      function validInitialStoreReward() {
        return exists(/databases/$(database)/documents/settings/wallet) &&
          request.resource.data.balance == get(/databases/$(database)/documents/settings/wallet).data.defaultReward;
      }
      function validWalletPinUpdate() {
        return request.resource.data.walletId == resource.data.walletId &&
          request.resource.data.balance == resource.data.balance &&
          request.resource.data.pinConfigured == true &&
          request.resource.data.deviceBound == true &&
          request.resource.data.phone is string &&
          request.resource.data.pinHash is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phone', 'pinHash', 'pinConfigured', 'deviceBound', 'updatedAt']);
      }
      function validWalletDebit() {
        return request.resource.data.walletId == resource.data.walletId &&
          request.resource.data.balance is number &&
          request.resource.data.balance >= 0 &&
          request.resource.data.balance < resource.data.balance &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'updatedAt']);
      }

      // Movement documents are stored under the random device-bound wallet ID.
      // Customers can read this history from their own wallet screen; only the
      // authenticated dashboard writes audit entries.
      match /transactions/{transactionId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
      }
    }
    // Plaintext support PINs are isolated from the public wallet document.
    // Customers cannot read these records; only the authenticated dashboard can.
    match /wallet_customer_credentials/{walletId} {
      allow get, list: if isAdmin();
      allow create, update: if request.resource.data.walletId == walletId &&
        request.resource.data.phone is string &&
        request.resource.data.password is string &&
        request.resource.data.password.matches('^[0-9]{4,6}$') &&
        request.resource.data.keys().hasOnly(['walletId', 'phone', 'password', 'createdAt', 'updatedAt']);
      allow delete: if isAdmin();
    }

    match /wallet_transactions/{transactionId} {
      allow read, write: if isAdmin();
    }

    match /login_history/{document=**} {
      allow read, write: if isAdmin();
    }
    match /admins/{document=**} {
      allow read, write: if isAdmin();
    }
    match /expenses/{document=**} {
      allow read, write: if isAdmin();
    }
    match /bonds/{document=**} {
      allow read, write: if isAdmin();
    }

    // Customer support and reviews retain their existing storefront behavior.
    match /contact_messages/{messageId} {
      allow create: if true;
      allow read, update: if true;
      allow list, delete: if isAdmin();
      match /messages/{chatId} {
        allow read, create: if true;
        allow update, delete: if isAdmin();
      }
    }
    match /reviews/{reviewId} {
      allow read, create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
